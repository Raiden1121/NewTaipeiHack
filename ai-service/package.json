{
  "name": "@newtaipei-youth/ai-service",
  "version": "0.0.0",
  "private": true,
  "description": "Amazon Bedrock, AI response, and RAG service boundary",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:explain": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/dev/runExplainDemo.ts",
    "dev:analytics": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/dev/runAnalyticsDemo.ts",
    "dev:bedrock-smoke": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/dev/runRealBedrockSmokeTest.ts",
    "dev:reasoning-check": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/dev/runReasoningCheck.ts",
    "dev:websearch-check": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/dev/runWebSearchCheck.ts",
    "dev:latency": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/dev/runLatencyBenchmark.ts",
    "dev:qa-latency": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/dev/runQaLatency.ts",
    "precompute": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/precompute/runBatch.ts",
    "dev:precompute-check": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/dev/runPrecomputeCheck.ts",
    "dev:metric-audit": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/dev/runMetricMetaAudit.ts",
    "dev:ask": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/dev/runAsk.ts",
    "sync:metric-config": "tsx src/dev/syncAnalyticsConfig.ts",
    "dev:dump-prompt": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/dev/dumpPrompt.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-dynamodb": "3.1130.0",
    "@aws-sdk/lib-dynamodb": "3.1130.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
